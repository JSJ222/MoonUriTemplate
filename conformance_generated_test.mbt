    }
    if !alternatives.contains(output) {
      fail("fixture mismatch: " + source + " => " + output)
    }
  }
}

///|
test "extended-tests.json: Additional Examples 7: Prefix Modifiers with Multibyte Characters" {
  let bindings : Array[(String, @moonuritemplate.Value)] = [
    ("var", Scalar("value")),
    ("greek", Scalar("αβγδε")),
    ("currency", Scalar("€uro")),
    ("clef", Scalar("𝄞stave")),
  ]
  let cases : Array[(String, Array[String])] = [
    ("{greek:1}", ["%CE%B1"]),
    ("{greek:2}", ["%CE%B1%CE%B2"]),
    ("{+greek:2}", ["%CE%B1%CE%B2"]),
    ("{greek:30}", ["%CE%B1%CE%B2%CE%B3%CE%B4%CE%B5"]),
    ("{currency:1}", ["%E2%82%AC"]),
    ("{?currency:1}", ["?currency=%E2%82%AC"]),
    ("{clef:1}", ["%F0%9D%84%9E"]),
    ("{var:9999}", ["value"]),
  ]
  for case in cases {
    let (source, alternatives) = case
    let template = match @moonuritemplate.parse(source, strict_literals=false) {
      Ok(value) => value
      Err(_) => fail("cannot parse fixture: " + source)
    }
    let output = match template.expand(bindings) {
      Ok(value) => value
      Err(_) => fail("cannot expand fixture: " + source)
    }
    if !alternatives.contains(output) {
      fail("fixture mismatch: " + source + " => " + output)
    }
  }
}

///|
test "extended-tests.json: Additional Examples 8: Literal Encoding" {
  let bindings : Array[(String, @moonuritemplate.Value)] = [
    ("var", Scalar("value")),
  ]
  let cases : Array[(String, Array[String])] = [
    ("café/{var}", ["caf%C3%A9/value"]),
    ("x%20y/{var}", ["x%20y/value"]),
    ("x%20y{var}z%20w", ["x%20yvaluez%20w"]),
  ]
  for case in cases {
    let (source, alternatives) = case
    let template = match @moonuritemplate.parse(source, strict_literals=false) {
      Ok(value) => value
      Err(_) => fail("cannot parse fixture: " + source)
    }
    let output = match template.expand(bindings) {
      Ok(value) => value
      Err(_) => fail("cannot expand fixture: " + source)
    }
    if !alternatives.contains(output) {
      fail("fixture mismatch: " + source + " => " + output)
    }
  }
}

///|
test "negative-tests.json: Failure Tests" {
  let bindings : Array[(String, @moonuritemplate.Value)] = [
    ("id", Scalar("thing")),
    ("var", Scalar("value")),
    ("hello", Scalar("Hello World!")),
    ("with space", Scalar("fail")),
    (" leading_space", Scalar("Hi!")),
    ("trailing_space ", Scalar("Bye!")),
    ("empty", Scalar("")),
    ("path", Scalar("/foo/bar")),
    ("x", Scalar("1024")),
    ("y", Scalar("768")),
    ("list", List(["red", "green", "blue"])),
    ("keys", Assoc([("semi", ";"), ("dot", "."), ("comma", ",")])),
    ("example", Scalar("red")),
    ("searchTerms", Scalar("uri templates")),
    ("~thing", Scalar("some-user")),
    (
      "default-graph-uri",
      List(["http://www.example/book/", "http://www.example/papers/"]),
    ),
    (
      "query",
      Scalar(
        "PREFIX dc: <http://purl.org/dc/elements/1.1/> SELECT ?book ?who WHERE { ?book dc:creator ?who }",
      ),
    ),
  ]
  let invalid : Array[String] = [
    "{/id*", "/id*}", "{/?id}", "{var:prefix}", "{hello:2*}", "{??hello}", "{!hello}",
    "{with space}", "{ leading_space}", "{trailing_space }", "{=path}", "{$var}",
    "{|var*}", "{*keys?}", "{?empty=default,var}", "{var}{-prefix|/-/|var}", "?q={searchTerms}&amp;c={example:color?}",
    "x{?empty|foo=none}", "/h{#hello+}", "/h#{hello+}", "{keys:1}", "{+keys:1}",
    "{;keys:1*}", "?{-join|&|var,list}", "/people/{~thing}", "/{default-graph-uri}",
    "/sparql{?query,default-graph-uri}", "/sparql{?query){&default-graph-uri*}",
    "/resolution{?x, y}", "{var:0}", "{var:01}", "{var:10000}", "{var:}", "{x.}",
    "{x..y}", "{%2x}",
  ]
  for source in invalid {
    let rejected = match @moonuritemplate.parse(source) {
      Err(_) => true
      Ok(template) => template.expand(bindings) is Err(_)
    }
    if !rejected {
      fail("accepted invalid fixture: " + source)
    }
  }
}
